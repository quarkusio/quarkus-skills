<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.quarkus.migration</groupId>
    <artifactId>migration-tests</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>Quarkus Migration Skill Tests</name>
    <description>Test harness for evaluating Quarkus migration skills</description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <jackson-3.version>3.2.2</jackson-3.version>
        <junit.version>5.12.2</junit.version>
        <smallrye-acp.version>0.1.0</smallrye-acp.version>

        <surefire-plugin.version>3.6.0</surefire-plugin.version>
        <maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
        <exec-maven-plugin.version>3.6.3</exec-maven-plugin.version>

        <!-- List of parameters that we can override
             See tests/README.md for provider setup instructions. -->
        <ai.provider></ai.provider>
        <ai.model></ai.model>
        <ai.strategy>full</ai.strategy>
        <ai.timeout>300</ai.timeout>
        <ai.cmd>claude</ai.cmd>
        <ai.projects></ai.projects>
        <ai.skills></ai.skills>
        <ai.enabled></ai.enabled>
        <ai.prompt></ai.prompt>
        <ai.args></ai.args>
        <ai.sanitize>false</ai.sanitize>
        <runs>1</runs>
        <runChecks>true</runChecks>
        <ai.review>false</ai.review>
    </properties>

    <dependencies>
        <!-- Smallrye Java ACP core lib -->
        <dependency>
            <groupId>io.smallrye.ai</groupId>
            <artifactId>acp-java-core</artifactId>
            <version>${smallrye-acp.version}</version>
        </dependency>
        <!-- Jackson YAML parsing -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson-3.version}</version>
        </dependency>
        <dependency>
            <groupId>tools.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
            <version>${jackson-3.version}</version>
        </dependency>
        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven-shade-plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.quarkus.ai.harness.launcher.Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>default-cli</id>
                        <configuration>
                            <executable>java</executable>
                            <arguments>
                                <argument>-Dai.provider=${ai.provider}</argument>
                                <argument>-Dai.model=${ai.model}</argument>
                                <argument>-Dai.strategy=${ai.strategy}</argument>
                                <argument>-Dai.timeout=${ai.timeout}</argument>
                                <argument>-Dai.cmd=${ai.cmd}</argument>
                                <argument>-Dai.projects=${ai.projects}</argument>
                                <argument>-Dai.skills=${ai.skills}</argument>
                                <argument>-Druns=${runs}</argument>
                                <argument>-DrunChecks=${runChecks}</argument>
                                <argument>-Dai.review=${ai.review}</argument>
                                <argument>-Dai.enabled=${ai.enabled}</argument>
                                <argument>-Dai.prompt=${ai.prompt}</argument>
                                <argument>-Dai.args=${ai.args}</argument>
                                <argument>-Dai.sanitize=${ai.sanitize}</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>io.quarkus.ai.harness.launcher.Main</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>checks</id>
                        <configuration>
                            <executable>java</executable>
                            <arguments>
                                <argument>-Dai.projects=${ai.projects}</argument>
                                <argument>-Dai.enabled=${ai.enabled}</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>io.quarkus.ai.harness.checks.CheckRunner</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <excludes>
                        <exclude>**/MigrationTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>integration</id>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>${surefire-plugin.version}</version>
                        <configuration>
                            <excludes combine.self="override"/>
                            <!-- Stream test output to console in real-time -->
                            <redirectTestOutputToFile>false</redirectTestOutputToFile>
                            <useFile>false</useFile>
                            <includes>
                                <include>**/MigrationTest.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <ai.provider>${ai.provider}</ai.provider>
                                <ai.model>${ai.model}</ai.model>
                                <ai.strategy>${ai.strategy}</ai.strategy>
                                <ai.timeout>${ai.timeout}</ai.timeout>
                                <ai.cmd>${ai.cmd}</ai.cmd>
                                <ai.projects>${ai.projects}</ai.projects>
                                <ai.skills>${ai.skills}</ai.skills>
                                <runs>${runs}</runs>
                                <runChecks>${runChecks}</runChecks>
                                <ai.review>${ai.review}</ai.review>
                                <ai.enabled>${ai.enabled}</ai.enabled>
                                <ai.prompt>${ai.prompt}</ai.prompt>
                                <ai.args>${ai.args}</ai.args>
                                <ai.sanitize>${ai.sanitize}</ai.sanitize>
                            </systemPropertyVariables>
                            <!-- Long-running tests -->
                            <forkedProcessTimeoutInSeconds>3600</forkedProcessTimeoutInSeconds>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
